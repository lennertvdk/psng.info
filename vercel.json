{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "fra1"
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/whatsapp",
      "destination": "/api/whatsapp"
    }
  ],
  "redirects": [
    {
      "source": "/lab",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/lab",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/deine-gruppe",
      "destination": "/leitfaden",
      "permanent": true
    },
    {
      "source": "/mitmachen",
      "destination": "https://forms.gle/2EK6dCXMhZtwWEVKA",
      "permanent": false
    },
    {
      "source": "/hr",
      "destination": "https://claude.ai/artifact/2BY5S6qyf5zfnCuLknC7SE",
      "permanent": false
    }
  ]
}
