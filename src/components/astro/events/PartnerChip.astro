---
import type { Partner } from "@/lib/events/types";

/*
 * Kurzer Hinweis auf die Partnerorganisation, neutral wie die übrigen Chips.
 * Bewusst ohne Link und ohne Partnerfarbe: Die Karte gehört zur PSNG-Reihe,
 * der Weg zur Partnerorganisation steht in der Kooperationsleiste.
 */
interface Props {
  partner: Pick<Partner, "short" | "name">;
}

const { partner } = Astro.props;
---

<span class="inline-flex items-center rounded-full border border-border bg-card px-2.5 py-0.5 text-xs font-medium text-foreground/75" title={partner.name}>
  {partner.short ?? partner.name}
</span>
