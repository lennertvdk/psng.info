---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowRight } from "lucide-react";
import AddToCalendar from "@/components/AddToCalendarIsland";
import { copy } from "@/i18n/copy";
import type { Locale } from "@/i18n/locale";
import { pick } from "@/i18n/localized";
import { calendarEntry } from "@/lib/events/calendarEntry";
import { formatEventDateRange, formatEventTime } from "@/lib/events/format";
import { eventPath } from "@/lib/events/paths";
import { canRegister, hasPage } from "@/lib/events/schedule";
import type { SiteEvent } from "@/lib/events/types";
import { columnLabel, registerHref } from "@/lib/events/view";
import PartnerChip from "../PartnerChip.astro";
import CardHead from "./CardHead.astro";
import LanguageNote from "./LanguageNote.astro";
import PartnerStrip from "./PartnerStrip.astro";

/*
 * Die volle Karte eines Events: kommend mit Anmeldung und Kalender, oder
 * vergangen ohne Fotos und Aufzeichnung. Text und Fakten stehen vollständig
 * da – die eigene Seite ist zum Teilen da, nicht zum Weiterlesen.
 */
interface Props {
  event: SiteEvent;
  events: SiteEvent[];
  locale: Locale;
  past: boolean;
  ref: Date;
}

const { event: e, events, locale, past, ref } = Astro.props;
const c = copy[locale];
const title = pick(e.title, locale);
// Ohne eigene Website ist das LinkedIn-Profil der nächstbeste Beleg.
const speakerLink = e.speakerWebsiteUrl ?? e.speakerLinkedinUrl;
const calendar = past ? undefined : calendarEntry(e, locale, c);
const register = !past && canRegister(e, ref);
const parent = e.partOf ? events.find((x) => x.slug === e.partOf) : undefined;
// `registrationUrl` führt nicht immer zu Luma – mal in die WhatsApp-Gruppe.
const luma = Boolean(e.registrationUrl?.includes("luma.com"));
const external = { target: "_blank", rel: "noopener noreferrer" };
const label = "font-medium text-foreground";
const page = hasPage(e) ? eventPath(e.slug, locale) : undefined;
// Die eigene Seite ist der eine hervorgehobene Link; alles Weitere tritt zurück.
const primaryLink = "inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline";
const moreLink = page ? "text-sm font-medium text-muted-foreground hover:text-primary" : "text-sm font-medium text-primary hover:underline";
---

<article class="overflow-hidden rounded-2xl border border-border bg-card">
  {
    e.cover && (
      <div class="aspect-[40/21] overflow-hidden bg-muted">
        <Image
          src={e.cover.src as ImageMetadata}
          alt={pick(e.cover.alt, locale)}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 860px, 100vw"
          class="h-full w-full object-cover"
        />
      </div>
    )
  }
  <div class="p-6">
    <CardHead date={`${formatEventDateRange(e, locale)}, ${formatEventTime(e, locale)}`} class="mb-3">
      <span class="chip">{columnLabel(e.column, c)}</span>
      {
        e.highlightBadge && (
          <span class="chip-accent">{pick(e.highlightBadge, locale)}</span>
        )
      }
      {
        e.speakerType && (
          <span class="chip-accent">
            {e.speakerType === "student" ? c.events.speakerTypes.student : c.events.speakerTypes.guest}
          </span>
        )
      }
      {e.partner?.tone && <PartnerChip partner={e.partner} />}
      {
        e.status !== "scheduled" && (
          <span class="chip-status">
            {e.status === "cancelled" ? c.eventPage.status.cancelled : c.eventPage.status.postponed}
          </span>
        )
      }
    </CardHead>

    <div>
      {
        e.speakerPhoto && (
          <Image
            src={e.speakerPhoto as ImageMetadata}
            alt={e.speaker ?? "Speaker"}
            width={105}
            height={105}
            densities={[1, 2]}
            class="float-right mb-1 ml-3 h-[105px] w-[105px] rounded-2xl object-cover shadow-sm"
          />
        )
      }
      <h3 class="mb-2 font-heading text-lg font-semibold text-foreground">
        {page ? <a href={page} class="hover:text-primary">{title}</a> : title}
      </h3>
      {e.subtitle && <p class="mb-2 text-sm font-medium leading-relaxed text-foreground/80">{pick(e.subtitle, locale)}</p>}
      {
        e.speaker && (
          <p class="mb-2 text-sm font-medium text-primary">
            {speakerLink ? (
              <a href={speakerLink} {...external} class="hover:underline">
                {e.speaker}
              </a>
            ) : (
              e.speaker
            )}
          </p>
        )
      }
      <div class="mb-2"><LanguageNote event={e} locale={locale} /></div>
      <p class="mb-4 whitespace-pre-line text-reading">{pick(e.description, locale) ?? c.events.detailsSoon}</p>
      {e.speakerBio && (
        <div class="mb-4">
          <p class="font-heading text-xs font-medium text-foreground">{c.eventPage.speaker}</p>
          <p class="mt-1 text-reading">{pick(e.speakerBio, locale)}</p>
        </div>
      )}
      {
        e.furtherReading?.length && (
          <div class="mb-4">
            <p class="font-heading text-xs font-medium text-foreground">{c.events.furtherReading}</p>
            <ol class="mt-1.5 max-w-[68ch] list-decimal space-y-1.5 pl-5 marker:text-muted-foreground">
              {e.furtherReading.map((r) => (
                <li class="pl-1 text-sm leading-relaxed">
                  <a href={r.url} {...external} class="text-foreground/80 underline decoration-border underline-offset-2 transition-colors hover:text-primary hover:decoration-primary">
                    {pick(r.text, locale)}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        )
      }
      {e.audienceNote && <p class="mb-4 max-w-[68ch] text-sm leading-relaxed text-muted-foreground">{pick(e.audienceNote, locale)}</p>}
      {
        parent && (
          <p class="mb-4 text-sm text-muted-foreground">
            {c.events.partOf}{" "}
            <a href={`#${parent.slug}`} class="font-medium text-primary hover:underline">
              {pick(parent.title, locale)}
            </a>
          </p>
        )
      }
    </div>

    <div class="clear-both space-y-1 text-sm text-muted-foreground">
      {/* Auf dem Handy steht das Datum schon im Kopf der Karte. */}
      <p class="hidden md:block"><span class={label}>{c.events.dateLabel}</span> {formatEventDateRange(e, locale)}, {formatEventTime(e, locale)}</p>
      {e.location && <p><span class={label}>{c.events.locationLabel}</span> {pick(e.location, locale)}</p>}
      {e.contribution && <p><span class={label}>{c.events.contributionLabel}</span> {pick(e.contribution, locale)}</p>}
    </div>
    {e.disclaimer && <p class="mt-3 text-xs italic text-muted-foreground">{pick(e.disclaimer, locale)}</p>}
    {!past && luma && <p class="mt-3 text-xs text-muted-foreground">{c.events.lumaHint}</p>}

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-3">
      {
        register && (
          <a
            href={registerHref(e, "events")}
            {...external}
            class="inline-flex bg-primary items-center justify-center rounded-lg px-4 py-2 font-heading text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-hover"
          >
            {pick(e.registrationLabel, locale) ?? c.events.register}
          </a>
        )
      }
      {
        page && (
          <a href={page} class={primaryLink}>
            {c.eventPage.eventPage}
            <ArrowRight size={14} aria-hidden="true" />
          </a>
        )
      }
      {calendar && <AddToCalendar client:visible locale={locale} event={calendar} />}
      {
        !past && e.websiteUrl && (
          <a href={e.websiteUrl} {...external} class={moreLink}>
            {pick(e.websiteLabel, locale) ?? c.events.learnMore} →
          </a>
        )
      }
      {
        e.externalUrl && (
          <a href={e.externalUrl} {...external} class={moreLink}>
            {pick(e.externalLabel, locale) ?? c.events.learnMore} →
          </a>
        )
      }
      {
        past && luma && (
          <a href={e.registrationUrl} {...external} class={moreLink}>
            {c.events.lumaLink}
          </a>
        )
      }
    </div>
  </div>
  {e.partner && e.role === "co-hosted" && <PartnerStrip partner={e.partner} locale={locale} />}
</article>
