---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { copy } from "@/i18n/copy";
import type { Locale } from "@/i18n/locale";
import { pick } from "@/i18n/localized";
import type { SiteEvent } from "@/lib/events/types";

/*
 * Die Kooperationsleiste am Kartenfuß: Logo, was die Organisation beigetragen
 * hat, und die Wege zu ihr. Trägt als einziger Teil der Karte die Farben der
 * Partnerorganisation, aber leise: Sie soll nicht stärker wirken als die
 * PSNG-eigenen Teile der Karte.
 */
interface Props {
  partner: NonNullable<SiteEvent["partner"]>;
  locale: Locale;
}

const { partner, locale } = Astro.props;
const c = copy[locale];
const link = "text-sm font-medium text-primary hover:underline";
---

<div class="surface-bpsa flex flex-wrap items-center gap-x-4 gap-y-2 px-5 py-3">
  <Image
    src={partner.logo as ImageMetadata}
    alt={`Logo ${partner.name}`}
    width={40}
    height={40}
    densities={[1, 2]}
    class="h-10 w-10 shrink-0 object-contain"
  />
  <div class="min-w-0 flex-1 basis-56">
    <p class="font-heading text-sm font-medium text-foreground">{c.events.inCooperationWith} {partner.name}</p>
    {partner.role && <p class="mt-0.5 text-sm text-foreground/75">{pick(partner.role, locale)}</p>}
    <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1">
      <a href={partner.url} target="_blank" rel="noopener noreferrer" class={link}>
        {partner.url.replace(/^https?:\/\//, "").replace(/\/$/, "")} →
      </a>
      {
        partner.instagramUrl && (
          <a href={partner.instagramUrl} target="_blank" rel="noopener noreferrer" class={link}>
            {c.events.instagram}
          </a>
        )
      }
    </div>
  </div>
</div>
