---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ExternalLink } from "lucide-react";
import AddToCalendar from "@/components/AddToCalendarIsland";
import { copy } from "@/i18n/copy";
import type { Locale } from "@/i18n/locale";
import { pick } from "@/i18n/localized";
import type { CalendarEvent } from "@/lib/calendar";
import { formatEventDateRange, formatEventTime } from "@/lib/events/format";
import type { SiteEvent } from "@/lib/events/types";
import { registerHref } from "@/lib/events/view";

/*
 * Die Faktenspalte der Event-Seite: Wann, Wo, Sprache, Anmeldung, Kalender,
 * nachher die Zahlen. EventDetail setzt sie bei kommenden Events vor den
 * Text, bei vergangenen dahinter – im DOM wie auf dem Bildschirm, damit
 * Tastatur und Screenreader dieselbe Reihenfolge erleben.
 */
interface Props {
  event: SiteEvent;
  locale: Locale;
  past: boolean;
  register: boolean;
  calendar?: CalendarEvent;
  attendance?: string;
  hasNumbers: boolean;
  shortEmbed?: string;
  title: string;
}

const { event: e, locale, past, register, calendar, attendance, hasNumbers, shortEmbed, title } = Astro.props;
const c = copy[locale];
const p = c.eventPage;
const img = (i: unknown) => i as ImageMetadata;
const external = { target: "_blank", rel: "noopener noreferrer" };
const textLink = "inline-flex min-w-0 items-center gap-1 text-sm font-medium text-primary [overflow-wrap:anywhere] hover:underline";
---

<div class:list={["space-y-4 md:col-start-2 md:row-start-1 md:self-start", !past && "md:sticky md:top-24"]}>
  <div class="space-y-4 rounded-xl border border-border/60 bg-card p-5">
    <dl class="space-y-3 text-sm">
      <div>
        <dt class="text-xs uppercase tracking-wider text-muted-foreground">{p.when}</dt>
        <dd class="font-medium text-foreground">{formatEventDateRange(e, locale)}</dd>
        <dd class="text-muted-foreground">{formatEventTime(e, locale)}</dd>
      </div>
      {
        (e.location || attendance) && (
          <div>
            <dt class="text-xs uppercase tracking-wider text-muted-foreground">{p.where}</dt>
            {e.location && <dd class="font-medium text-foreground">{pick(e.location, locale)}</dd>}
            {e.venue?.street && !pick(e.location, locale)?.includes(e.venue.street) && (
              <dd class="text-muted-foreground">
                {e.venue.street}, {e.venue.postalCode} {e.venue.city}
              </dd>
            )}
          </div>
        )
      }
      {
        e.language && (
          <div>
            <dt class="text-xs uppercase tracking-wider text-muted-foreground">{p.language}</dt>
            <dd class="font-medium text-foreground">{c.events.languages[e.language]}</dd>
          </div>
        )
      }
    </dl>
    {
      register ? (
        <a
          href={registerHref(e, "event-seite")}
          {...external}
          class="flex w-full bg-primary items-center justify-center gap-1.5 rounded-lg px-4 py-2.5 font-heading text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-hover"
        >
          {pick(e.registrationLabel, locale) ?? c.events.register}
          <ExternalLink size={14} aria-hidden="true" />
        </a>
      ) : (
        !past &&
        e.status === "scheduled" &&
        e.registrationState !== "open" && (
          <p class="rounded-lg bg-muted px-4 py-2.5 text-center text-sm font-medium text-muted-foreground">
            {e.registrationState === "full" ? p.registration.full : p.registration.closed}
          </p>
        )
      )
    }
    {
      // Eigener Block: Die Insel selbst ist `display: contents` und nimmt
      // den Abstand von `space-y-4` nicht an.
      calendar && (
        <div class="[&_.inline-block]:block [&_button[aria-haspopup]]:w-full [&_button[aria-haspopup]]:justify-center [&_button[aria-haspopup]]:px-3">
          <AddToCalendar client:visible locale={locale} event={calendar} />
        </div>
      )
    }
    {
      (e.websiteUrl || e.externalUrl) && (
        <a href={e.websiteUrl ?? e.externalUrl} {...external} class={textLink}>
          {pick(e.websiteLabel ?? e.externalLabel, locale) ?? p.toWebsite}
          <ExternalLink size={13} aria-hidden="true" />
        </a>
      )
    }
  </div>
  {
    hasNumbers && (
      <section class="rounded-xl border border-border/60 bg-card p-5">
        <h2 class="sr-only">{p.numbers}</h2>
        <dl class="grid grid-cols-2 gap-x-4 gap-y-3">
          {e.attendees && (
            <div>
              <dt class="text-xs text-muted-foreground">{c.events.attendees}</dt>
              <dd class="font-heading text-2xl font-bold text-foreground">{e.attendees}</dd>
            </div>
          )}
          {e.attendeesOnline !== undefined && (
            <div>
              <dt class="text-xs text-muted-foreground">{p.ofWhichOnline}</dt>
              <dd class="font-heading text-2xl font-bold text-foreground">{e.attendeesOnline}</dd>
            </div>
          )}
          {e.rating && (
            <div>
              <dt class="text-xs text-muted-foreground">{c.events.rating}</dt>
              <dd class="font-heading text-2xl font-bold text-foreground">{e.rating}</dd>
            </div>
          )}
          {e.recommendPercent !== undefined && (
            <div>
              <dt class="text-xs text-muted-foreground">{c.events.recommend}</dt>
              <dd class="font-heading text-2xl font-bold text-foreground">{e.recommendPercent} %</dd>
            </div>
          )}
        </dl>
        {(e.slidesUrl || e.recapUrl) && (
          <div class="mt-4 flex flex-wrap gap-4 border-t border-border/50 pt-4">
            {e.slidesUrl && <a href={e.slidesUrl} {...external} class={textLink}>{c.events.slides}</a>}
            {e.recapUrl && <a href={e.recapUrl} {...external} class={textLink}>{c.events.recap}</a>}
          </div>
        )}
      </section>
    )
  }
  {
    past && shortEmbed && (
      <div class="relative mx-auto aspect-[9/16] w-full max-w-[17rem] overflow-hidden rounded-xl bg-muted">
        <button
          type="button"
          data-youtube={shortEmbed}
          data-title={c.events.shortTitle}
          class="group absolute inset-0 flex items-center justify-center"
          aria-label={`${c.events.playShort} ${title}`}
        >
          <Image src={img(e.short!.thumbnail)} alt="" width={272} height={484} densities={[1, 2]} class="absolute inset-0 h-full w-full object-cover" />
          <span class="absolute inset-0 bg-black/25 transition-colors group-hover:bg-black/40"></span>
          <span class="relative flex h-14 w-14 items-center justify-center rounded-full bg-white/90 text-foreground shadow-lg transition-transform group-hover:scale-110">
            <svg viewBox="0 0 24 24" class="ml-1 h-6 w-6" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
          </span>
        </button>
      </div>
    )
  }
</div>
