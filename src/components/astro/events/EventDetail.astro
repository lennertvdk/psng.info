---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowLeft, ArrowRight, ChevronLeft, ChevronRight, ExternalLink, X } from "lucide-react";
import AddToCalendar from "@/components/AddToCalendarIsland";
import { copy } from "@/i18n/copy";
import type { Locale } from "@/i18n/locale";
import { pick } from "@/i18n/localized";
import { pathFor } from "@/i18n/routes";
import { calendarEntry, seriesCalendarEntry } from "@/lib/events/calendarEntry";
import { formatEventDate } from "@/lib/events/format";
import { eventPath } from "@/lib/events/paths";
import { canRegister, getChildEvents, getUpcomingAgenda, hasPage, isPast, isTranslated } from "@/lib/events/schedule";
import type { SiteEvent } from "@/lib/events/types";
import { columnLabel } from "@/lib/events/view";
import { getYouTubeEmbedUrl } from "@/lib/youtube";
import EventFacts from "./EventFacts.astro";
import PartnerChip from "./PartnerChip.astro";

/*
 * Die Seite eines Events. Vorher stehen Fakten und Anmeldung vorn, nachher
 * der Rückblick – Aufzeichnung, Fotos, Zahlen. Was in den Daten fehlt, wird
 * nicht gerendert, auch keine leere Überschrift.
 */
interface Props {
  event: SiteEvent;
  events: SiteEvent[];
  locale: Locale;
  ref: Date;
}

const { event: e, events, locale, ref } = Astro.props;
const c = copy[locale];
const p = c.eventPage;
const past = isPast(e, ref);
const title = pick(e.title, locale);
const calendar = !past ? calendarEntry(e, locale, c) : undefined;
const register = canRegister(e, ref) && e.registrationUrl;
const children = getChildEvents(events, e.slug);
const parent = e.partOf ? events.find((x) => x.slug === e.partOf) : undefined;
// Die Nachbarn in der Zeit, unter allen Events mit eigener Seite.
const chronological = events.filter(hasPage).sort((a, b) => a.date.localeCompare(b.date) || a.slug.localeCompare(b.slug));
const position = chronological.findIndex((x) => x.slug === e.slug);
const neighbours = { prev: chronological[position - 1], next: chronological[position + 1] };
// Der nächste anstehende Termin – nur, wenn er weder diese Seite noch schon
// ihr Nachbar ist. Ist diese Seite selbst der nächste Termin, steht nichts da:
// Den übernächsten braucht hier niemand.
const upcomingFirst = getUpcomingAgenda(events, ref)[0];
const next =
  upcomingFirst &&
  !(upcomingFirst.kind === "event" && [e.slug, neighbours.next?.slug].includes(upcomingFirst.event.slug)) &&
  (upcomingFirst.kind === "series" || hasPage(upcomingFirst.event))
    ? upcomingFirst
    : undefined;
const embed = e.recording && getYouTubeEmbedUrl(e.recording.url);
const shortEmbed = e.short && getYouTubeEmbedUrl(e.short.url);
const img = (i: unknown) => i as ImageMetadata;
/** Nur der allgemeine Titel „Lecture mit {Name}“ weicht dem Vortragstitel aus dem Abstract. */
const genericTitle = e.category === "lecture" && Boolean(e.speaker) && title.includes(e.speaker!);
const talkTitle = genericTitle && e.abstract?.title ? pick(e.abstract.title, locale) : undefined;
const bare = (s: string) => s.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, "");
const subtitle = e.subtitle && pick(e.subtitle, locale);
/** Der Untertitel fällt nur weg, wenn er die H1 bloß wiederholt. */
const showSubtitle = Boolean(subtitle) && !(talkTitle && bare(subtitle!) === bare(talkTitle));
/** Bei Vorträgen steht die Person mit Foto direkt unter dem Titel. */
const byline = e.category === "lecture" && Boolean(e.speaker);
const attendance = e.attendance === "online" ? p.online : e.attendance === "hybrid" ? p.hybrid : undefined;

const h2 = "mb-3 font-heading text-xl font-semibold text-foreground";
const photos = e.photos ?? [];
const galleryButton =
  "absolute flex h-11 w-11 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur transition-colors hover:bg-white/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white";
const hasNumbers = past && Boolean(e.attendees || e.rating || e.recommendPercent || e.slidesUrl || e.recapUrl);
const external = { target: "_blank", rel: "noopener noreferrer" };
const textLink = "inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline";
---

<article class="container mx-auto max-w-5xl px-6 pb-24 pt-32 md:pt-40">
  <nav class="mb-8 flex flex-wrap items-center justify-between gap-4" aria-label={p.allEvents}>
    {/* Zurück an dieselbe Stelle im Zeitstrahl, nicht an dessen Anfang. */}
    <a
      href={`${pathFor("events", locale)}#${e.slug}`}
      class="inline-flex items-center gap-2 font-heading text-sm text-muted-foreground transition-colors hover:text-primary"
    >
      <ArrowLeft size={16} aria-hidden="true" />
      {p.allEvents}
    </a>
    <div class="flex gap-2">
      {
        // Wie im Zeitstrahl, wo das Neuere oben steht: links geht es zum
        // späteren Event, rechts zum früheren. Die Beschriftung sagt es dazu,
        // weil „links = neuer“ allein niemand errät.
        (["next", "prev"] as const).map((dir) => {
          const target = neighbours[dir];
          const Icon = dir === "next" ? ChevronLeft : ChevronRight;
          const label = dir === "prev" ? p.prevEvent : p.nextEvent;
          const short = dir === "prev" ? p.older : p.newer;
          const cls = `inline-flex h-11 items-center gap-1 rounded-full border border-border font-heading text-sm font-medium ${dir === "next" ? "pl-3 pr-4" : "pl-4 pr-3"}`;
          const content = dir === "next" ? [<Icon size={18} aria-hidden="true" />, short] : [short, <Icon size={18} aria-hidden="true" />];
          return target ? (
            <a href={eventPath(target.slug, locale)} class={`${cls} text-foreground transition-colors hover:border-primary hover:text-primary`} aria-label={`${label}: ${pick(target.title, locale)}`} title={pick(target.title, locale)}>
              {content}
            </a>
          ) : (
            <span class={`${cls} text-muted-foreground/50`} aria-hidden="true">
              {content}
            </span>
          );
        })
      }
    </div>
  </nav>

  {locale === "en" && !isTranslated(e) && <p class="mb-6 rounded-lg bg-muted px-4 py-2 text-sm text-muted-foreground">{p.untranslated}</p>}

  <header class="mb-10">
    <div class="mb-3 flex flex-wrap items-center gap-2">
      <span class="chip">{columnLabel(e.column, c)}</span>
      {
        e.speakerType && (
          <span class="chip-accent">
            {e.speakerType === "student" ? c.events.speakerTypes.student : c.events.speakerTypes.guest}
          </span>
        )
      }
      {e.partner?.tone && <PartnerChip partner={e.partner} />}
      {e.highlightBadge && <span class="chip-accent">{pick(e.highlightBadge, locale)}</span>}
    </div>
    {/* Bei Vorträgen trägt der Vortragstitel die Seite, der Name steht in der Byline. */}
    <h1 lang={talkTitle && e.abstract?.title ? e.abstract.lang : undefined} class="text-balance font-heading text-3xl font-bold leading-tight text-foreground md:text-5xl">{talkTitle ?? title}</h1>
    {showSubtitle && <p class="mt-3 max-w-[68ch] text-lg text-foreground/75">{subtitle}</p>}
    {
      byline && (
        <p class="mt-5 flex items-center gap-3">
          {e.speakerPhoto && (
            <Image src={img(e.speakerPhoto)} alt="" width={48} height={48} densities={[1, 2]} class="h-12 w-12 shrink-0 rounded-full object-cover" />
          )}
          <span class="font-heading text-base font-medium text-foreground">{e.speaker}</span>
        </p>
      )
    }
    {
      parent && (
        <p class="mt-3 text-sm text-muted-foreground">
          {c.events.partOf}{" "}
          <a href={eventPath(parent.slug, locale)} class="font-medium text-primary hover:underline">
            {pick(parent.title, locale)}
          </a>
        </p>
      )
    }
  </header>

  {
    e.status !== "scheduled" ? (
      <div class="mb-10 rounded-xl border border-destructive/30 bg-destructive/5 px-5 py-4" role="status">
        <p class="font-heading font-semibold text-destructive">
          {e.status === "cancelled" ? p.status.cancelled : p.status.postponed}
        </p>
        <p class="text-sm text-muted-foreground">{e.status === "cancelled" ? p.status.cancelledText : p.status.postponedText}</p>
      </div>
    ) : (
      e.rescheduledFrom &&
      !past && (
        <p class="mb-10 rounded-xl bg-notice px-5 py-3 text-sm text-notice-foreground" role="status">
          {p.status.rescheduledBefore}
          {formatEventDate(e.rescheduledFrom, locale)}.
        </p>
      )
    )
  }

  <div class="grid grid-cols-[minmax(0,1fr)] gap-10 md:grid-cols-[minmax(0,1fr)_18rem]">
    {/* Kommende Events: Wann, Wo und Anmeldung vor dem Text, auf dem Handy wie im DOM. */}
    {!past && (
      <EventFacts
        event={e}
        locale={locale}
        past={past}
        register={Boolean(register)}
        calendar={calendar}
        attendance={attendance}
        hasNumbers={hasNumbers}
        shortEmbed={shortEmbed || undefined}
        title={title}
      />
    )}
    <div class="min-w-0 space-y-10 md:col-start-1 md:row-start-1">
      {
        past && embed && (
          <section>
            <h2 class="sr-only">{p.recording}</h2>
            <div class="relative aspect-video overflow-hidden rounded-xl bg-muted">
              <button
                type="button"
                data-youtube={embed}
                data-title={title}
                class="group absolute inset-0 flex items-center justify-center"
                aria-label={`${c.events.playRecording} ${title}`}
              >
                <Image src={img(e.recording!.thumbnail)} alt="" widths={[640, 960, 1280]} sizes="(min-width: 768px) 640px, 100vw" class="absolute inset-0 h-full w-full object-cover" />
                <span class="absolute inset-0 bg-black/25 transition-colors group-hover:bg-black/40"></span>
                <span class="relative flex h-16 w-16 items-center justify-center rounded-full bg-white/90 text-foreground shadow-lg transition-transform group-hover:scale-110">
                  <svg viewBox="0 0 24 24" class="ml-1 h-7 w-7" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
                </span>
              </button>
            </div>
          </section>
        )
      }

      {
        past && photos.length > 0 && (
          <section>
            <h2 class={h2}>{p.photos}</h2>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
              {photos.slice(0, 3).map((photo, i) => (
                <a href={img(photo.src).src} data-gallery-open={i} class={`block overflow-hidden rounded-lg bg-muted ${i === 0 ? "col-span-2 row-span-2" : ""}`}>
                  <Image
                    src={img(photo.src)}
                    alt={pick(photo.alt, locale) ?? ""}
                    widths={i === 0 ? [640, 1024] : [320, 640]}
                    loading="eager"
                    sizes={i === 0 ? "(min-width: 768px) 440px, 100vw" : "(min-width: 768px) 220px, 50vw"}
                    class="aspect-[4/3] h-full w-full object-cover transition-transform hover:scale-[1.02]"
                  />
                </a>
              ))}
            </div>
            {photos.length > 3 && (
              <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
                {photos.slice(3).map((photo, i) => (
                  <a href={img(photo.src).src} data-gallery-open={i + 3} class="block overflow-hidden rounded-lg bg-muted">
                    <Image
                      src={img(photo.src)}
                      alt={pick(photo.alt, locale) ?? ""}
                      widths={[240, 480]}
                      sizes="(min-width: 768px) 165px, 50vw"
                      class="aspect-[4/3] h-full w-full object-cover transition-transform hover:scale-[1.02]"
                    />
                  </a>
                ))}
              </div>
            )}
            <dialog
              data-gallery
              aria-label={`${p.photos}: ${title}`}
              class="m-0 h-dvh max-h-none w-screen max-w-none bg-black p-0 text-white backdrop:bg-black/80"
            >
              <ul
                data-gallery-track
                class="flex h-full snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
              >
                {photos.map((photo, i) => (
                  <li class="flex h-full w-full shrink-0 snap-center items-center justify-center p-2 sm:p-14">
                    <Image
                      src={img(photo.src)}
                      alt={pick(photo.alt, locale) ?? `${title} – ${c.events.photoFallback} ${i + 1}`}
                      widths={[960, 1440, 2048]}
                      sizes="100vw"
                      loading="lazy"
                      class="max-h-full max-w-full object-contain"
                    />
                  </li>
                ))}
              </ul>
              <p data-gallery-count class="absolute left-4 top-4 text-sm tabular-nums text-white/80" aria-live="polite"></p>
              <button type="button" data-gallery-close class={`${galleryButton} right-3 top-3`} aria-label={p.closeGallery}>
                <X size={20} aria-hidden="true" />
              </button>
              {photos.length > 1 && (
                <>
                  <button type="button" data-gallery-prev class={`${galleryButton} left-3 top-1/2 -translate-y-1/2`} aria-label={c.events.prevPhoto}>
                    <ChevronLeft size={22} aria-hidden="true" />
                  </button>
                  <button type="button" data-gallery-next class={`${galleryButton} right-3 top-1/2 -translate-y-1/2`} aria-label={c.events.nextPhoto}>
                    <ChevronRight size={22} aria-hidden="true" />
                  </button>
                </>
              )}
            </dialog>
          </section>
        )
      }

      {
        (e.description || e.abstract) && (
          <section>
            <h2 class={h2}>
              {e.abstract ? p.abstract : p.about}
              {e.abstract?.lang && e.abstract.lang !== locale && ` (${c.events.languages[e.abstract.lang]})`}
            </h2>
            {e.language && e.language !== locale && (
              <p class="mb-3 text-sm text-muted-foreground">
                {(e.category === "lecture" ? c.events.languageNote.talk : c.events.languageNote.event).before}
                <span class="font-medium text-foreground">
                  {(e.category === "lecture" ? c.events.languageNote.talk : c.events.languageNote.event).in}
                  {c.events.languages[e.language]}
                </span>.
              </p>
            )}
            {e.abstract ? (
              <>
                {e.abstract.title && !talkTitle && <h3 lang={e.abstract.lang} class="mb-2 font-heading font-semibold text-foreground">{pick(e.abstract.title, locale)}</h3>}
                <p lang={e.abstract.lang} class="whitespace-pre-line text-reading md:text-[1.0625rem]">{pick(e.abstract.text, locale)}</p>
              </>
            ) : (
              <p class="whitespace-pre-line text-reading md:text-[1.0625rem]">{pick(e.description, locale)}</p>
            )}
            {e.audienceNote && <p class="mt-3 text-sm text-muted-foreground">{pick(e.audienceNote, locale)}</p>}
            {e.contribution && (
              <p class="mt-3 text-sm text-muted-foreground">
                <span class="font-medium text-foreground">{c.events.contributionLabel}</span> {pick(e.contribution, locale)}
              </p>
            )}
          </section>
        )
      }

      {
        children.length > 0 && (
          <section>
            <h2 class={h2}>{p.talksThatEvening}</h2>
            <ul class="space-y-3">
              {children.map((child) => (
                <li class="rounded-xl border border-border/60 bg-card p-4">
                  <a href={eventPath(child.slug, locale)} class="font-heading font-semibold text-foreground hover:text-primary">
                    {pick(child.title, locale)}
                  </a>
                  {child.speaker && <p class="text-sm text-muted-foreground">{child.speaker}</p>}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        e.speaker && (e.speakerBio || e.speakerPhoto) && (
          <section>
            <h2 class={h2}>{p.speaker}</h2>
            <div class="flex gap-4">
              {e.speakerPhoto && !byline && (
                <Image src={img(e.speakerPhoto)} alt={e.speaker} width={96} height={96} densities={[1, 2]} class="h-24 w-24 shrink-0 rounded-full object-cover" />
              )}
              <div class="min-w-0 break-words">
                <p class="font-heading font-semibold text-foreground">{e.speaker}</p>
                {e.speakerBio && <p class="mt-1 text-reading">{pick(e.speakerBio, locale)}</p>}
                {(e.speakerWebsiteUrl || e.speakerLinkedinUrl) && (
                  <div class="mt-2 flex flex-wrap gap-4">
                    {e.speakerWebsiteUrl && <a href={e.speakerWebsiteUrl} {...external} class={textLink}>{c.events.learnMore}<ExternalLink size={13} aria-hidden="true" /></a>}
                    {e.speakerLinkedinUrl && <a href={e.speakerLinkedinUrl} {...external} class={textLink}>{c.events.linkedin}<ExternalLink size={13} aria-hidden="true" /></a>}
                  </div>
                )}
              </div>
            </div>
          </section>
        )
      }

      {
        e.partner && (
          <section>
            <h2 class={h2}>{p.partner}</h2>
            <div class="flex items-center gap-4">
              <Image src={img(e.partner.logo)} alt={`${e.partner.name} Logo`} height={56} densities={[1, 2]} class="h-14 w-auto shrink-0" />
              <div class="min-w-0 break-words">
                <a href={e.partner.url} {...external} class="font-heading font-semibold text-foreground hover:text-primary">{e.partner.name}</a>
                {e.partner.role && <p class="text-sm text-muted-foreground">{pick(e.partner.role, locale)}</p>}
              </div>
            </div>
          </section>
        )
      }

      {
        e.furtherReading?.length && (
          <section>
            <h2 class={h2}>{c.events.furtherReading}</h2>
            <ol class="max-w-[68ch] list-decimal space-y-2 pl-5 marker:text-muted-foreground">
              {e.furtherReading.map((r) => (
                <li class="pl-1 leading-relaxed">
                  <a href={r.url} {...external} class="text-foreground/80 underline decoration-border underline-offset-2 transition-colors hover:text-primary hover:decoration-primary">{pick(r.text, locale)}</a>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {e.disclaimer && <p class="text-sm italic text-muted-foreground">{pick(e.disclaimer, locale)}</p>}
    </div>

    {past && (
      <EventFacts
        event={e}
        locale={locale}
        past={past}
        register={Boolean(register)}
        calendar={calendar}
        attendance={attendance}
        hasNumbers={hasNumbers}
        shortEmbed={shortEmbed || undefined}
        title={title}
      />
    )}
  </div>

  {
    (neighbours.prev || neighbours.next || next) && (
      <div class="mt-16 space-y-4 border-t border-border/60 pt-10">
      {(neighbours.prev || neighbours.next) && <nav class="grid grid-cols-1 gap-4 sm:grid-cols-2" aria-label={`${p.nextEvent} / ${p.prevEvent}`}>
        {neighbours.next ? (
          <a href={eventPath(neighbours.next.slug, locale)} class="group rounded-xl border border-border/60 bg-card p-5 transition-shadow hover:shadow-lg">
            <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">
              <ChevronLeft size={14} aria-hidden="true" />
              {p.nextEvent} · {formatEventDate(neighbours.next.date, locale)}
            </span>
            <span class="mt-1 block font-heading font-semibold text-foreground group-hover:text-primary">{pick(neighbours.next.title, locale)}</span>
          </a>
        ) : (
          <span />
        )}
        {neighbours.prev && (
          <a href={eventPath(neighbours.prev.slug, locale)} class="group rounded-xl border border-border/60 bg-card p-5 text-right transition-shadow hover:shadow-lg">
            <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">
              {p.prevEvent} · {formatEventDate(neighbours.prev.date, locale)}
              <ChevronRight size={14} aria-hidden="true" />
            </span>
            <span class="mt-1 block font-heading font-semibold text-foreground group-hover:text-primary">{pick(neighbours.prev.title, locale)}</span>
          </a>
        )}
      </nav>}
      {
        next && (
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl bg-primary/5 px-5 py-4">
            <p class="font-heading text-xs font-semibold uppercase tracking-[0.2em] text-primary">{p.next}</p>
            <p class="text-sm text-muted-foreground">{formatEventDate(next.date, locale, true)}</p>
            {next.kind === "event" ? (
              <a href={eventPath(next.event.slug, locale)} class="inline-flex items-center gap-1 font-heading font-semibold text-foreground hover:text-primary">
                {pick(next.event.title, locale)}
                <ArrowRight size={14} aria-hidden="true" />
              </a>
            ) : (
              <>
                <p class="font-heading font-semibold text-foreground">
                  {next.series.labelKey === "semesterStart" ? c.events.seriesSemesterLabel : c.events.seriesLabel}
                </p>
                <AddToCalendar client:visible locale={locale} event={seriesCalendarEntry(next.series, locale, c)} subtle />
              </>
            )}
          </div>
        )
      }
      </div>
    )
  }

</article>

<script>
  import { initGallery } from "@/scripts/gallery";
  import { initYouTubeButtons } from "@/scripts/youtube";
  initGallery();
  initYouTubeButtons();
</script>
