---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ChevronDown } from "lucide-react";
import teamPhoto from "@/assets/Team-2026-08.webp";
import AddToCalendar from "@/components/AddToCalendarIsland";
import ContactSection from "@/components/ContactSection";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { copy } from "@/i18n/copy";
import type { Locale } from "@/i18n/locale";
import { intlLocale, pick } from "@/i18n/localized";
import { pathFor } from "@/i18n/routes";
import { HOME_ANCHORS } from "@/lib/anchors";
import { loadPartnerList } from "@/lib/content";
import { calendarEntry, seriesCalendarEntry } from "@/lib/events/calendarEntry";
import { formatEventDate, formatEventDateRange, formatEventTime, formatSeriesTime } from "@/lib/events/format";
import { loadEvents, loadFeatures } from "@/lib/events/load";
import { eventPath } from "@/lib/events/paths";
import { getHeroSlot, getProofEvents, getUpcomingAgenda, parseEventDate, proofImage } from "@/lib/events/schedule";
import { cardAction, columnLabel } from "@/lib/events/view";
import { legacyAnchorTargets } from "@/lib/legacyAnchors";
import { whatsappHref } from "@/lib/links";
import { alternatesOf } from "@/lib/seo/alternates";
import { graph, organizationNode, websiteNode } from "@/lib/seo/structuredData";
import HeroCard from "./HeroCard.astro";
import { chip, eyebrow, primaryButton, secondaryButton, sectionTitle, textLink } from "./styles";

/*
 * Die Startseite: wer wir sind, was als Nächstes kommt, wie man dazukommt.
 * Gebaut mit dem Datum des Builds – scripts/freshness.ts blendet aus, was
 * seitdem vorbei ist, bis die tägliche Neuerstellung nachzieht.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copy[locale];
const ref = new Date();
/** Das Event, dessen erstes Foto unter dem Hero steht. */
const HERO_PHOTO_EVENT = "alps-conference-2026";
const [events, features, partners] = await Promise.all([loadEvents(), loadFeatures(), loadPartnerList()]);

const slot = getHeroSlot(events, features, ref);
const heroId = slot.kind === "event" ? slot.event.slug : slot.kind === "series" ? slot.series.id : undefined;
/** Höchstens so viele Termine nach dem im Hero. Mehr steht auf /events. */
const agenda = getUpcomingAgenda(events, ref)
  .filter((entry) => entry.id !== heroId)
  .slice(0, 3);
// Steht ein Rückblick schon im Hero, braucht es ihn weiter unten nicht noch einmal.
const proof = getProofEvents(
  // Ohne das Event, das schon im Hero steht, und ohne das Event hinter dem Foto darunter.
  events.filter((e) => !(slot.kind === "recap" && slot.event.slug === e.slug) && e.slug !== HERO_PHOTO_EVENT),
  ref,
);
const legacy = legacyAnchorTargets(events, locale);
/** Das Foto unter dem Hero: die PSNG-Gruppe auf der ALPS Conference 2026. */
const heroPhotoEvent = events.find((e) => e.slug === HERO_PHOTO_EVENT);
const heroPhoto = heroPhotoEvent?.photos?.[0];
const [feature, ...moreProof] = proof;
/** Wie auf der Detailseite: statt „Lecture mit {Name}“ der Vortragstitel, der Name darunter. */
const featureTalk =
  feature?.speaker && feature.abstract?.title && pick(feature.title, locale).includes(feature.speaker) ? pick(feature.abstract.title, locale) : undefined;
const bare = (s: string) => s.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, "");
const featureHeading = feature && (featureTalk ?? pick(feature.title, locale));
const featureSubtitle = feature?.subtitle && pick(feature.subtitle, locale);
/** Untertitel nur, wenn er nicht bloß die Überschrift wiederholt. */
const showFeatureSubtitle = Boolean(featureSubtitle) && bare(featureSubtitle!) !== bare(featureHeading ?? "");
/** Der erste Absatz des Abstracts (sonst der Beschreibung), ungekürzt. */
const featureLead = feature && (feature.abstract ? pick(feature.abstract.text, locale) : pick(feature.description, locale))?.split(/\n\s*\n/)[0];
const figures = (e: (typeof proof)[number]) =>
  [
    e.attendees && { value: String(e.attendees), label: c.events.attendees },
    e.attendees && e.attendeesOnline !== undefined && { value: String(e.attendeesOnline), label: c.events.online },
    e.attendees && e.attendeesOnline !== undefined && { value: String(e.attendees - e.attendeesOnline), label: c.events.inPerson },
    e.rating && { value: String(e.rating), label: c.events.rating },
    e.recommendPercent && { value: `${e.recommendPercent} %`, label: c.events.recommend },
  ].filter(Boolean) as { value: string; label: string }[];

const anchor = (hash: string) => `#${hash}`;
const external = { target: "_blank", rel: "noopener noreferrer" };
const onboardingTargets: Record<string, { href: string; external?: boolean }> = {
  join: { href: whatsappHref("einstieg"), external: true },
  // Zur Übersicht, nicht zum Abschnitt darunter: Der ist leer, wenn die
  // Hero-Karte den einzigen Termin schon zeigt.
  events: { href: pathFor("events", locale) },
  start: { href: pathFor("guide", locale) },
};

const stats = [c.hero.students, c.hero.cities, c.lab.since].map((item) => {
  // „250+ Studierende“: Die Zahl trägt, das Wort erklärt.
  const [first, ...rest] = item.split(" ");
  return /\d/.test(first) ? { lead: first, rest: rest.join(" ") } : { rest: item };
});

const dateParts = (iso: string) => {
  const date = parseEventDate(iso);
  const fmt = (opts: Intl.DateTimeFormatOptions) => date.toLocaleDateString(intlLocale(locale), opts);
  return { weekday: fmt({ weekday: "short" }), day: fmt({ day: "numeric" }), month: fmt({ month: "short" }) };
};

/** Die eine Zeile, die eine Kachel belegt: Zahlen, sonst Aufzeichnung, Ort oder Fotos. */
const proofFigure = (e: (typeof proof)[number]) => {
  if (e.attendees) {
    return [`${e.attendees} ${c.events.attendees}`, e.rating && `${e.rating} ${c.events.rating}`].filter(Boolean).join(" · ");
  }
  if (e.recording) return `▶ ${c.eventPage.recording}`;
  if (e.venue) return `${e.venue.city}${e.venue.country !== "DE" ? ` (${e.venue.country})` : ""}`;
  return `${e.photos?.length ?? 0} ${c.eventPage.photos}`;
};
---

<BaseLayout
  locale={locale}
  title={c.meta.home.title}
  description={c.meta.home.description}
  alternates={alternatesOf("home")}
  jsonLd={graph(organizationNode(c.meta.home.description), websiteNode(locale))}
>
  {/* Alte Anker (#events, #team, #event-…) auf ihre neuen Ziele – vor dem ersten Zeichnen. */}
  <script slot="head" is:inline define:vars={{ legacy }}>
    const target = legacy[decodeURIComponent(location.hash.slice(1))];
    if (target) {
      const [path, hash] = target.split("#");
      location.replace(path + location.search + (hash ? "#" + hash : ""));
    }
  </script>

  <section data-track="hero" class="relative overflow-hidden bg-[linear-gradient(165deg,hsl(var(--primary)/0.05)_0%,hsl(var(--coral)/0.06)_40%,hsl(var(--background))_80%)] pb-12 pt-24 md:pb-16 md:pt-32">
    <div
      class:list={[
        "container mx-auto grid items-center gap-10 px-4 sm:px-6",
        slot.kind === "none" ? "max-w-3xl" : "lg:grid-cols-[1.05fr_0.95fr] lg:gap-14",
      ]}
    >
      <div class="animate-rise-in">
        <h1 class="font-heading text-[2rem] font-bold leading-[1.1] text-foreground sm:text-5xl lg:text-[3.5rem]">
          {c.lab.hero.headlineBefore}<span class="text-primary">{c.lab.hero.headlineAccent}</span>{c.lab.hero.headlineAfter}
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-foreground/75 md:text-lg">{c.lab.hero.text}</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a href={whatsappHref("hero")} {...external} class={primaryButton}>{c.hero.joinWhatsapp}</a>
          <a href={anchor(HOME_ANCHORS.groups)} class={secondaryButton}>{c.hero.foundGroup}</a>
        </div>
        <p class="mt-3 text-xs text-muted-foreground">
          {/* Ab Laptop-Breite beginnt jeder Satz in einer eigenen Zeile. */}
          {c.lab.hero.whatsappNote.split(/(?<=\.) /).map((s, i) => (i ? [<br class="hidden md:inline" />, " ", s] : s))}
        </p>
        <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-3 border-t border-foreground/10 pt-5">
          {
            stats.map((item) => (
              <li class:list={["font-heading text-sm text-foreground/75", !item.lead && "self-end"]}>
                {item.lead && <strong class="block text-2xl font-bold leading-none text-foreground">{item.lead}</strong>}
                <span class:list={[item.lead && "mt-1 block"]}>{item.rest}</span>
              </li>
            ))
          }
        </ul>
      </div>
      {
        slot.kind !== "none" && (
          <div class="animate-rise-in" style="animation-delay: 0.1s" data-track="hero-karte">
            <HeroCard hero={slot} locale={locale} ref={ref} />
          </div>
        )
      }
    </div>
    {
      heroPhoto && heroPhotoEvent && (
        <figure class="container mx-auto mt-12 max-w-[calc(1200px+3rem)] px-4 sm:px-6 md:mt-16">
          <Image
            src={heroPhoto.src as ImageMetadata}
            alt={pick(heroPhoto.alt, locale) ?? ""}
            widths={[640, 1200]}
            sizes="(min-width: 1280px) 1200px, 100vw"
            loading="eager"
            class="aspect-[4/3] w-full rounded-2xl object-cover sm:aspect-[16/9]"
          />
          <figcaption class="mt-3 text-sm text-muted-foreground">
            <a href={eventPath(heroPhotoEvent.slug, locale)} class="font-medium text-foreground hover:text-primary">{pick(heroPhotoEvent.title, locale)}</a>
            {" · "}{formatEventDateRange(heroPhotoEvent, locale)}
          </figcaption>
        </figure>
      )
    }
  </section>

  <section aria-labelledby="home-ways" class="bg-card py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="mb-10 max-w-2xl" data-reveal>
        <h2 id="home-ways" class={sectionTitle}>{c.onboarding.title}</h2>
      </div>
      <ol class="grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-border bg-border md:grid-cols-3" data-reveal>
        {
          c.onboarding.steps.map((step) => {
            const target = onboardingTargets[step.key];
            return (
              <li class="flex flex-col bg-card p-6 md:p-8">
                <h3 class="font-heading text-xl font-semibold text-foreground">{step.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{step.desc}</p>
                <a href={target.href} {...(target.external ? external : {})} class={`${secondaryButton} mt-6 self-start`}>
                  {step.cta}
                </a>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  {/* Nur, wenn nach dem Termin im Hero noch etwas kommt. Läuft alles ab,
       blendet scripts/freshness.ts den ganzen Abschnitt aus. */}
  {agenda.length > 0 && (
  <section id={HOME_ANCHORS.agenda} aria-labelledby="home-agenda" data-hide-when-expired class="scroll-mt-20 bg-primary/5 py-16 md:py-24">
    <div class="container mx-auto grid grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div data-reveal>
        <p class={`${eyebrow} mb-3`}>{c.lab.agenda.eyebrow}</p>
        <h2 id="home-agenda" class={sectionTitle}>{c.lab.agenda.title}</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
          <span class="font-medium text-foreground">{c.events.seriesNoteBefore}</span>{" "}{
            [
              c.events.seriesNoteEvery,
              c.events.seriesNoteAfter,
            ].join(" ")
          }
        </p>
        <a href={pathFor("events", locale)} class={`${textLink} mt-5 inline-block`}>{c.lab.agenda.all}</a>
      </div>
      {
        agenda.length > 0 && (
          <ol class="divide-y divide-border border-y border-border" data-reveal>
            {agenda.map((entry) => {
              const parts = dateParts(entry.date);
              const end = entry.kind === "event" ? (entry.event.endDate ?? entry.date) : entry.date;
              const e = entry.kind === "event" ? entry.event : undefined;
              const action = e && cardAction(e, locale, c, ref);
              const calendar = entry.kind === "series" ? seriesCalendarEntry(entry.series, locale, c) : calendarEntry(entry.event, locale, c);
              return (
                <li class="flex gap-5 py-6" data-expires={end}>
                  <div class="w-14 shrink-0 text-center" aria-hidden="true">
                    <p class="font-heading text-xs font-medium uppercase text-muted-foreground">{parts.weekday}</p>
                    <p class="font-heading text-3xl font-bold leading-none text-foreground">{parts.day}</p>
                    <p class="font-heading text-xs font-medium uppercase text-primary">{parts.month}</p>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="sr-only">{e ? formatEventDateRange(e, locale) : formatEventDate(entry.date, locale, true)}</p>
                    <div class="mb-2 flex flex-wrap gap-2">
                      <span class={chip}>{columnLabel(entry.column, c)}</span>
                    </div>
                    {entry.kind === "series" ? (
                      <>
                        <h3 class="font-heading text-lg font-semibold text-foreground">
                          {entry.series.labelKey === "semesterStart" ? c.events.seriesSemesterLabel : c.events.seriesLabel}
                        </h3>
                        <p class="mt-1 text-sm text-muted-foreground">
                          {formatSeriesTime(entry.series)} · {entry.series.location}. {c.events.seriesNote}
                          {entry.series.coHost && ` ${c.events.seriesCoHost} ${entry.series.coHost}.`}
                        </p>
                      </>
                    ) : (
                      <>
                        <h3 class="font-heading text-lg font-semibold leading-snug text-foreground">
                          {action ? (
                            <a href={action.href} {...(action.external ? external : {})} class="hover:text-primary">
                              {pick(e!.title, locale)}
                            </a>
                          ) : (
                            pick(e!.title, locale)
                          )}
                        </h3>
                        {e!.speaker && <p class="mt-1 text-sm font-medium text-primary">{e!.speaker}</p>}
                        <p class="mt-1 text-sm text-muted-foreground">
                          {formatEventTime(e!, locale)} · {pick(e!.location, locale)}
                        </p>
                      </>
                    )}
                    <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
                      {calendar && <AddToCalendar client:visible locale={locale} event={calendar} subtle />}
                      {action && (
                        <a href={action.href} {...(action.external ? external : {})} tabindex="-1" aria-hidden="true" class={textLink}>
                          {action.label} →
                        </a>
                      )}
                    </div>
                  </div>
                </li>
              );
            })}
          </ol>
        )
      }
    </div>
  </section>
  )}

  {
    proof.length > 0 && (
      <section aria-labelledby="home-proof" class="bg-card py-16 md:py-24">
        <div class="container mx-auto px-4 sm:px-6">
          <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
            <div>
              <h2 id="home-proof" class={sectionTitle}>{c.lab.proof.title}</h2>
            </div>
            <a href={pathFor("events", locale)} class={textLink}>{c.lab.agenda.all}</a>
          </div>
          {/* Der stärkste Rückblick groß, mit Zahlen, die übrigen darunter. */}
          <a href={eventPath(feature.slug, locale)} class="group mt-10 grid grid-cols-1 overflow-hidden rounded-2xl border border-border bg-card transition-shadow hover:shadow-lg lg:grid-cols-[1.4fr_1fr]" data-reveal>
            <div class="aspect-[4/3] overflow-hidden bg-muted lg:aspect-auto">
              <Image
                src={proofImage(feature) as ImageMetadata}
                alt=""
                widths={[640, 1000]}
                sizes="(min-width: 1024px) 700px, 100vw"
                class="h-full w-full object-cover"
              />
            </div>
            <div class="flex flex-col p-6 md:p-10">
              <p class="text-sm text-muted-foreground">
                {formatEventDate(feature.date, locale)}
                {feature.partner ? ` · ${c.events.with} ${feature.partner.short ?? feature.partner.name}` : ""}
              </p>
              <h3 class="mt-2 text-balance font-heading text-2xl font-bold leading-tight text-foreground group-hover:text-primary md:text-3xl">
                {featureHeading}
              </h3>
              {featureTalk && <p class="mt-2 font-heading text-base font-medium text-foreground">{feature.speaker}</p>}
              {showFeatureSubtitle && <p class="mt-3 text-lg text-foreground/80">{featureSubtitle}</p>}
              {featureLead && <p lang={feature.abstract?.lang} class="mt-4 text-reading">{featureLead}</p>}
              {
                figures(feature).length > 0 ? (
                  <dl class="mt-auto flex flex-wrap gap-x-8 gap-y-4 pt-8">
                    {figures(feature).map((f) => (
                      <div>
                        <dt class="sr-only">{f.label}</dt>
                        <dd class="font-heading text-3xl font-bold leading-none text-foreground">{f.value}</dd>
                        <dd class="mt-1 text-sm text-muted-foreground" aria-hidden="true">{f.label}</dd>
                      </div>
                    ))}
                  </dl>
                ) : (
                  <p class="mt-auto pt-8 text-sm font-medium text-foreground">{proofFigure(feature)}</p>
                )
              }
            </div>
          </a>
          {
            moreProof.length > 0 && (
              <ul class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
                {moreProof.map((e) => (
                  <li>
                    <a href={eventPath(e.slug, locale)} class="group block h-full overflow-hidden rounded-2xl border border-border bg-card transition-shadow hover:shadow-lg">
                      <div class="aspect-[3/2] overflow-hidden bg-muted">
                        <Image
                          src={proofImage(e) as ImageMetadata}
                          alt=""
                          widths={[400, 800]}
                          sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
                          class="h-full w-full object-cover"
                        />
                      </div>
                      <div class="p-5">
                        <p class="text-sm text-muted-foreground">
                          {formatEventDate(e.date, locale)}
                          {e.partner ? ` · ${c.events.with} ${e.partner.short ?? e.partner.name}` : ""}
                        </p>
                        <h3 class="mt-1 font-heading text-lg font-semibold leading-snug text-foreground group-hover:text-primary">
                          {pick(e.title, locale)}
                        </h3>
                        <p class="mt-3 text-sm font-medium text-foreground">{proofFigure(e)}</p>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }

          <div class="mt-14" data-reveal>
            <p class="text-center font-heading text-xs uppercase tracking-[0.2em] text-muted-foreground">{c.partners.stripeLabel}</p>
            <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
              {
                partners.map((partner) => (
                  <li>
                    <a href={partner.url} {...external} title={partner.displayName ?? partner.name} class="block transition [@media(hover:hover)]:opacity-70 [@media(hover:hover)]:grayscale [@media(hover:hover)]:hover:opacity-100 [@media(hover:hover)]:hover:grayscale-0">
                      <Image
                        src={partner.logo}
                        alt={partner.displayName ?? partner.name}
                        height={48}
                        densities={[1, 2]}
                        class="h-12 w-auto max-w-[9rem] object-contain"
                      />
                    </a>
                  </li>
                ))
              }
            </ul>
            <p class="mt-6 text-center">
              <a href={`${pathFor("about", locale)}#kooperation`} class={textLink}>{c.lab.credibility.partnersLink}</a>
            </p>
          </div>
        </div>
      </section>
    )
  }

  <section id={HOME_ANCHORS.groups} aria-labelledby="home-groups" class="scroll-mt-20 bg-card py-16 md:py-24">
    <div class="container mx-auto grid grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <h2 id="home-groups" class={sectionTitle}>{c.guide.title}</h2>
        <p class="mt-4 max-w-lg text-base leading-relaxed text-muted-foreground">{c.lab.groups.intro}</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a href={`?subject=gruppe#${HOME_ANCHORS.contact}`} class={primaryButton}>{c.lab.groups.cta}</a>
          <a href={pathFor("guide", locale)} class={secondaryButton}>{c.guide.cardCta}</a>
        </div>
      </div>
      <ol class="border-t border-border" data-reveal>
        {
          c.lab.groups.steps.map((step, i) => (
            <li class="flex gap-5 border-b border-border py-5">
              <span class="w-8 shrink-0 font-heading text-sm font-bold text-primary" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h3 class="font-heading text-base font-semibold text-foreground">{step.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{step.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section aria-labelledby="home-credibility" class="bg-primary/5 py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-3xl" data-reveal>
        <h2 id="home-credibility" class={sectionTitle}>{c.lab.credibility.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-foreground/75">{c.lab.credibility.mission}</p>
      </div>
      <ul class="mt-10 grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
        {
          c.lab.credibility.items.map((item) => (
            <li class="border-t-2 border-coral pt-4">
              <h3 class="font-heading text-base font-semibold text-foreground">{item.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{item.desc}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
        <a href={pathFor("codeOfConduct", locale)} class={textLink}>{c.lab.credibility.codeOfConduct}</a>
        <a href={pathFor("about", locale)} class={textLink}>{c.lab.credibility.about}</a>
      </div>

      <div class="mt-14 grid grid-cols-1 items-center gap-8 rounded-2xl border border-border bg-card p-6 md:grid-cols-[minmax(0,20rem)_1fr] md:p-8" data-reveal>
        <Image
          src={teamPhoto}
          alt={c.team.photoCaption}
          widths={[320, 640]}
          sizes="(min-width: 768px) 320px, 100vw"
          class="h-auto w-full rounded-xl"
        />
        <div>
          <h3 class="font-heading text-xl font-semibold text-foreground">{c.team.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{c.team.intro}</p>
          <a href={`${pathFor("about", locale)}#team`} class={`${textLink} mt-4 inline-block`}>{c.lab.credibility.teamLink}</a>
        </div>
      </div>

    </div>
  </section>

  <section id={HOME_ANCHORS.faq} aria-labelledby="home-faq" class="scroll-mt-20 py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl" data-reveal>
        <h2 id="home-faq" class={sectionTitle}>{c.faq.title}</h2>
      </div>
      <div class="mx-auto max-w-2xl space-y-3" data-reveal>
        {
          c.faq.items.map((faq) => (
            <details class="group rounded-xl border border-border bg-card px-6 transition-colors hover:border-primary/30">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-heading text-sm font-medium text-foreground hover:text-primary [&::-webkit-details-marker]:hidden">
                {faq.question}
                <ChevronDown size={16} aria-hidden="true" className="shrink-0 transition-transform duration-200 group-open:rotate-180" />
              </summary>
              <p class="pb-5 text-reading">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <ContactSection client:visible locale={locale} />
</BaseLayout>

<script>
  import { initFreshness } from "@/scripts/freshness";
  initFreshness();
</script>
