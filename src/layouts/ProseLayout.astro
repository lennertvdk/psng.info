---
import { ArrowLeft } from "lucide-react";
import BaseLayout from "./BaseLayout.astro";
import SectionToc from "@/components/astro/SectionToc.astro";
import { copy } from "@/i18n/copy";
import { pathFor } from "@/i18n/routes";

/**
 * Lange Textseiten: Impressum, Datenschutz, Code of Conduct, Leitfaden.
 * Mit `toc` steht ab 960 px das Inhaltsverzeichnis am linken Fensterrand.
 * Der Text steht in der mittleren von drei Spalten und damit mittig, solange
 * links genug Platz für das Verzeichnis bleibt; sonst rückt er nach rechts.
 */
type Props = Parameters<typeof BaseLayout>[0] & {
  heading: string;
  toc?: { href: string; label: string }[];
};

const { heading, toc, ...layout } = Astro.props;
const c = copy[layout.locale];
---

<BaseLayout {...layout}>
  <div
    class:list={[
      "container mx-auto px-6 pb-24 pt-32 md:pt-40",
      toc &&
        "min-[960px]:grid min-[960px]:max-w-none min-[960px]:grid-cols-[minmax(13rem,1fr)_minmax(0,48rem)_minmax(0,1fr)] min-[960px]:gap-x-10 min-[960px]:pl-8",
    ]}
  >
    {
      toc && (
        <div class="hidden min-[960px]:block">
          <SectionToc items={toc} label={c.nav.tocLabel} />
        </div>
      )
    }
    <div class:list={["mx-auto max-w-3xl", toc && "min-[960px]:mx-0 min-[960px]:max-w-none"]}>
      <a
        href={pathFor("home", layout.locale)}
        class="mb-8 inline-flex items-center gap-2 font-heading text-sm text-muted-foreground transition-colors hover:text-primary"
      >
        <ArrowLeft size={16} aria-hidden="true" />
        {c.legal.back}
      </a>
      <h1 class="mb-10 font-heading text-3xl font-bold text-foreground md:text-5xl">{heading}</h1>
      <div
        class="prose prose-sm prose-neutral max-w-none font-body md:prose-base prose-headings:font-heading prose-a:text-primary"
      >
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
